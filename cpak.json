{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Codex",
  "description": "OpenAI's coding agent for the terminal.",
  "version": "0.150.1",
  "image": "ghcr.io/containerpak/codex@sha256:5d1a8971945dd9f4881df2d94a5356ee4fe06ca29e3ec3b5a5e95986cbee3279",
  "binaries": [
    "/usr/bin/codex"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [
    "github.com/containerpak/sdk-scm",
    "github.com/containerpak/sdk-cli",
    "github.com/containerpak/sdk-go",
    "github.com/containerpak/sdk-node-lts",
    "github.com/containerpak/sdk-python",
    "github.com/containerpak/sdk-rust",
    "github.com/containerpak/sdk-native",
    "github.com/containerpak/sdk-java",
    "github.com/containerpak/sdk-php",
    "github.com/containerpak/sdk-ruby",
    "github.com/containerpak/sdk-lua",
    "github.com/containerpak/sdk-zig",
    "github.com/containerpak/sdk-vala",
    "github.com/containerpak/sdk-qt",
    "github.com/containerpak/sdk-vulkan",
    "github.com/containerpak/sdk-mingw"
  ],
  "idle_time": 0,
  "override": {
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filePicker": {},
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [
      "CODEX_DISABLE_UPDATE_CHECK=1"
    ]
  }
}
